# Local dev — uses local server on port 3000 (run: cd server && npm run dev)
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_BLOG_PUBLIC_URL=https://www.tradingsignals.ai

# --- CLIENT Vercel project (server-side env, NOT VITE_*) ---
# API_SERVER_URL=https://your-server.vercel.app
# VERCEL_PROTECTION_BYPASS=your-token-if-server-is-protected

# --- Only if testing localhost against deployed API ---
# VITE_USE_REMOTE_API=true
# VITE_API_PROXY_TARGET=https://your-server.vercel.app
# VITE_VERCEL_PROTECTION_BYPASS=your-token
